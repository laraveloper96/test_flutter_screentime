import DeviceActivity
import FamilyControls
import ManagedSettings
import os

// ⚠️  Reemplaza con tu App Group ID (debe coincidir con el de la app principal)
private let kAppGroupID = "group.your.app"

private let extLog = Logger(
  subsystem: "com.your.app.DeviceActivityMonitorExt",
  category: "DeviceActivityMonitor"
)

final class DeviceActivityMonitorExtension: DeviceActivityMonitor {

  private let store = ManagedSettingsStore()

  private var sharedDefaults: UserDefaults? {
    UserDefaults(suiteName: kAppGroupID)
  }

  // -------------------------------------------------------------------------
  // intervalDidStart
  // Llamado cuando comienza una ventana de horario.
  // Para el horario "flutter_control_parental.schedule" re-aplica el bloqueo.
  // -------------------------------------------------------------------------
  override func intervalDidStart(for activity: DeviceActivityName) {
    extLog.info("⏱️ intervalDidStart: \(activity.rawValue)")
    guard activity.rawValue == "flutter_control_parental.schedule" else { return }
    let isEnabled = sharedDefaults?.bool(forKey: "flutter_control_parental.blockingEnabled") ?? false
    guard isEnabled else { return }
    applyShielding()
  }

  // -------------------------------------------------------------------------
  // intervalDidEnd
  // Dos casos:
  //  • "flutter_control_parental.temporary_access" → el periodo de acceso temporal
  //    expiró → re-aplica el escudo si el bloqueo sigue activo.
  //  • cualquier otro (e.g. "flutter_control_parental.schedule") → ventana de horario
  //    terminó → limpia el escudo.
  // -------------------------------------------------------------------------
  override func intervalDidEnd(for activity: DeviceActivityName) {
    extLog.info("⏱️ intervalDidEnd: \(activity.rawValue)")

    switch activity.rawValue {
    case "flutter_control_parental.temporary_access":
      let isEnabled = sharedDefaults?.bool(forKey: "flutter_control_parental.blockingEnabled") ?? false
      if isEnabled {
        extLog.info("⏱️ temporary_access expirado — re-aplicando escudo")
        applyShielding()
      } else {
        extLog.info("⏱️ temporary_access expirado — bloqueo no activo, sin acción")
      }

    default:
      extLog.info("⏱️ \(activity.rawValue) terminado — limpiando escudo")
      store.clearAllSettings()
    }
  }

  // -------------------------------------------------------------------------
  // eventDidReachThreshold
  // Llamado cuando se alcanza el límite de tiempo diario configurado.
  // -------------------------------------------------------------------------
  override func eventDidReachThreshold(_ event: DeviceActivityEvent.Name, activity: DeviceActivityName) {
    extLog.info("⏱️ eventDidReachThreshold: \(event.rawValue) — \(activity.rawValue)")
    let isEnabled = sharedDefaults?.bool(forKey: "flutter_control_parental.blockingEnabled") ?? false
    guard isEnabled else { return }
    applyShielding()
  }

  // -------------------------------------------------------------------------
  // Helpers
  // -------------------------------------------------------------------------

  /// Lee la FamilyActivitySelection guardada en App Group y aplica el escudo.
  private func applyShielding() {
    guard
      let data = sharedDefaults?.data(forKey: "flutter_control_parental.blockedSelection"),
      let selection = try? PropertyListDecoder().decode(FamilyActivitySelection.self, from: data)
    else {
      extLog.error("⏱️ applyShielding: no se pudo leer blockedSelection del App Group '\(kAppGroupID)'")
      return
    }

    store.shield.applications = selection.applicationTokens.isEmpty
      ? nil
      : selection.applicationTokens

    store.shield.applicationCategories = selection.categoryTokens.isEmpty
      ? nil
      : ShieldSettings.ActivityCategoryPolicy.specific(selection.categoryTokens)

    extLog.info(
      "⏱️ applyShielding: escudo aplicado — apps=\(selection.applicationTokens.count) cats=\(selection.categoryTokens.count)"
    )
  }
}
