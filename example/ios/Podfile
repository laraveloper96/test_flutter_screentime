platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

target 'ShieldConfigurationExtension' do
  use_frameworks!
  inherit! :search_paths
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      if target.name == 'ShieldConfigurationExtension'
        config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'NO'
      end
    end
  end

  # Fix definitivo para el ciclo de build Flutter + App Extensions.
  # Deshabilita "Based on dependency analysis" en el script "Thin Binary"
  # de Flutter (equivalente a marcar alwaysOutOfDate = 1 en Xcode).
  # Esto rompe el ciclo circular entre Thin Binary, Embed Pods Frameworks
  # y Embed App Extensions sin afectar la correctitud del build.
  project_path = File.join(File.dirname(File.realpath(__FILE__)), 'Runner.xcodeproj')
  project = Xcodeproj::Project.open(project_path)

  # Fix definitivo para ciclo de build Flutter + App Extensions:
  # El ciclo ocurre porque [CP] Embed Pods Frameworks declara
  # flutter_screentime.framework como output via outputFileListPaths,
  # y Xcode crea un edge de dependencia desde CodeSign hacia ese output.
  # Al vaciar los output_file_list_paths Xcode no puede rastrear ese edge
  # y el ciclo desaparece. El script sigue embebiendo los frameworks
  # correctamente porque outputFileListPaths solo afecta el análisis de
  # dependencias, no la ejecución del script.
  project.targets.each do |target|
    next unless target.name == 'Runner'
    target.build_phases.each do |phase|
      next unless phase.is_a?(Xcodeproj::Project::Object::PBXShellScriptBuildPhase)
      if phase.name == 'Thin Binary'
        phase.always_out_of_date = '1'
        phase.input_paths = []
        phase.output_paths = []
        phase.input_file_list_paths = []
        phase.output_file_list_paths = []
      elsif phase.name == '[CP] Embed Pods Frameworks'
        phase.always_out_of_date = '1'
        phase.input_file_list_paths = []
        phase.output_paths = []
        phase.output_file_list_paths = []
      end
    end
  end

  project.save
end
