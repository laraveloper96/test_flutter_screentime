// ShieldActionExtension.swift
// Copia como ShieldActionExtension.swift en tu target de extensión.

import ManagedSettings
import Foundation
import os

private let kAppGroupID   = "group.your.app" // ⚠️ Reemplaza con tu App Group ID
private let kNotification = "dev.iori.flutter_control_parental.shield_action"

private let log = Logger(
    subsystem: "com.your.app.ShieldActionExt",
    category: "ShieldAction"
)

class ShieldActionExtension: ShieldActionDelegate {

    override func handle(
        action: ShieldAction,
        for application: ApplicationToken,
        completionHandler: @escaping (ShieldActionResponse) -> Void
    ) {
        respond(to: action, completionHandler: completionHandler)
    }

    override func handle(
        action: ShieldAction,
        for webDomain: WebDomainToken,
        completionHandler: @escaping (ShieldActionResponse) -> Void
    ) {
        respond(to: action, completionHandler: completionHandler)
    }

    override func handle(
        action: ShieldAction,
        for category: ActivityCategoryToken,
        completionHandler: @escaping (ShieldActionResponse) -> Void
    ) {
        respond(to: action, completionHandler: completionHandler)
    }

    private func respond(
        to action: ShieldAction,
        completionHandler: @escaping (ShieldActionResponse) -> Void
    ) {
        switch action {
        case .primaryButtonPressed:
            openMainApp(completionHandler: completionHandler)
        case .secondaryButtonPressed:
            completionHandler(.close)
        @unknown default:
            completionHandler(.close)
        }
    }

    private func openMainApp(completionHandler: @escaping (ShieldActionResponse) -> Void) {
        guard let url = URL(string: "flutter-control-parental://shield-action?button=primary") else {
            postShieldActionFallback()
            completionHandler(.defer)
            return
        }

        // extensionContext?.open abre la app principal directamente.
        // Si no está soportado en este contexto, el fallback usa Darwin notification.
        extensionContext?.open(url, completionHandler: { [weak self] success in
            if !success {
                self?.postShieldActionFallback()
            }
            completionHandler(.defer)
        })
    }

    private func postShieldActionFallback() {
        guard let defaults = UserDefaults(suiteName: kAppGroupID) else { return }
        defaults.set("primaryButton", forKey: "flutter_control_parental.pendingShieldAction")
        defaults.synchronize()

        let center = CFNotificationCenterGetDarwinNotifyCenter()
        CFNotificationCenterPostNotification(
            center,
            CFNotificationName(kNotification as CFString),
            nil, nil, true
        )
    }
}
