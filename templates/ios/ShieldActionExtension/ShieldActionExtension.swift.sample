// ShieldActionExtension.swift
// Copia como ShieldActionExtension.swift en tu target de extensión.
//
// REQUISITOS:
//   1. Target "Shield Action Extension" en Xcode
//   2. URL scheme "flutter-screentime" registrado en la app principal
//      (Runner > Info > URL Types: identifier=flutter-screentime, scheme=flutter-screentime)
//   3. App Group compartido con la app principal

import ManagedSettings

private let kAppGroupID = "group.your.app" // ⚠️ Reemplaza con tu App Group ID

class ShieldActionExtension: ShieldActionDelegate {

    // MARK: - App individual bloqueada

    override func handle(
        _ action: ShieldAction,
        for application: Application,
        completionHandler: @escaping (ShieldActionResponse) -> Void
    ) {
        respond(to: action, completionHandler: completionHandler)
    }

    // MARK: - App bloqueada por categoría

    override func handle(
        _ action: ShieldAction,
        for applicationCategory: ApplicationCategory,
        completionHandler: @escaping (ShieldActionResponse) -> Void
    ) {
        respond(to: action, completionHandler: completionHandler)
    }

    // MARK: - Lógica compartida

    private func respond(
        to action: ShieldAction,
        completionHandler: @escaping (ShieldActionResponse) -> Void
    ) {
        switch action {
        case .primaryButton:
            // Abre la app principal con deep link → el plugin emitirá ShieldAction.primaryButton
            // Caso de uso: el usuario pulsa "Pedir permiso" y la app abre la pantalla de solicitud
            let url = URL(string: "flutter-screentime://shield-action?button=primary")!
            completionHandler(.open(url))

        case .secondaryButton:
            // Cierra el shield sin abrir nada
            // Caso de uso: el usuario pulsa "Cancelar" y vuelve a la pantalla anterior
            completionHandler(.close)

        @unknown default:
            completionHandler(.close)
        }
    }
}

/*
 ─────────────────────────────────────────────────────────────────────────────
 CONFIGURACIÓN EN XCODE (pasos obligatorios)
 ─────────────────────────────────────────────────────────────────────────────

 1. URL Scheme en la app principal
    Runner > Info > URL Types > (+)
      Identifier : flutter-screentime
      URL Schemes: flutter-screentime

 2. App Group en ambos targets
    Runner                   > Signing & Capabilities > App Groups > group.your.app
    ShieldActionExtension    > Signing & Capabilities > App Groups > group.your.app

 3. Entitlement Family Controls en Runner
    Runner > Signing & Capabilities > Family Controls   (activado)

 ─────────────────────────────────────────────────────────────────────────────
 FLUJO COMPLETO
 ─────────────────────────────────────────────────────────────────────────────

  [Shield] ──(primario)──▶ .open("flutter-screentime://shield-action?button=primary")
                               │
                               └──▶ AppDelegate ──▶ FlutterScreentimePlugin
                                        │
                                   onShieldAction()  →  ShieldAction.primaryButton
                                   onPermissionRequest() (alias filtrado)
                                        │
                                   Flutter muestra pantalla "Pedir permiso"
                                        │
                              [Aprobar N minutos]
                                        │
                               grantTemporaryAccess(duration: Duration(minutes: 5))
                                        │
                                   Bloqueo desactivado N min → reactiva automáticamente

  [Shield] ──(secundario)──▶ .close   (shield se cierra, app bloqueada no se abre)

 ─────────────────────────────────────────────────────────────────────────────
 USO EN FLUTTER
 ─────────────────────────────────────────────────────────────────────────────

  final shield = ShieldExtension();

  // Escuchar solicitud de permiso (solo botón primario)
  shield.onPermissionRequest().listen((_) {
    showPermissionDialog();
  });

  // Al aprobar:
  await shield.grantTemporaryAccess(duration: Duration(minutes: 5));
*/
